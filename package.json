{
  "name": "sbom-visualizer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.1",
    "carbon-preprocess-svelte": "^0.11.40",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "sass-embedded": "^1.102.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@carbon/layout": "^11.57.0",
    "@carbon/styles": "^1.113.0",
    "@carbon/themes": "^11.79.0",
    "@carbon/type": "^11.65.0",
    "@cyclonedx/cyclonedx-library": "^9.5.0",
    "@dagrejs/dagre": "2.0.3",
    "@dagrejs/graphlib": "^2.2.4",
    "@ibm/plex": "^6.4.1",
    "carbon-components-svelte": "^0.99.3",
    "carbon-icons-svelte": "^13.14.0",
    "graphology": "^0.26.0",
    "graphology-operators": "^1.6.1",
    "graphology-shortest-path": "^2.1.0",
    "graphology-simple-path": "^0.2.0",
    "sigma": "^3.0.3"
